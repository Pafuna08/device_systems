{
  "info": {
    "name": "device_systems API",
    "description": "Colección de Postman para pruebas de la API REST de gestión de usuarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Obtener todos los usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8000/users",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["users"]
            },
            "description": "Retorna la lista completa de usuarios registrados"
          },
          "response": []
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8000/users/1",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["users", "1"]
            },
            "description": "Obtiene un usuario específico por su ID"
          },
          "response": []
        },
        {
          "name": "Filtrar por rol (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8000/users?role=admin",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["users"],
              "query": [
                {
                  "key": "role",
                  "value": "admin"
                }
              ]
            },
            "description": "Filtra los usuarios por el rol 'admin'"
          },
          "response": []
        },
        {
          "name": "Filtrar por estado activo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8000/users?is_active=true",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["users"],
              "query": [
                {
                  "key": "is_active",
                  "value": "true"
                }
              ]
            },
            "description": "Filtra los usuarios activos del sistema"
          },
          "response": []
        },
        {
          "name": "Crear usuario (Éxito)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"name\\\": \\\"Carlos Mendoza\\\",\\n  \\\"email\\\": \\\"carlos.mendoza@device-systems.com\\\",\\n  \\\"role\\\": \\\"support\\\",\\n  \\\"is_active\\\": true\\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/users",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["users"]
            },
            "description": "Crea un nuevo usuario con datos válidos"
          },
          "response": []
        },
        {
          "name": "Crear usuario (Email duplicado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"name\\\": \\\"Admin Usuario Duplicado\\\",\\n  \\\"email\\\": \\\"admin@device-systems.com\\\",\\n  \\\"role\\\": \\\"user\\\",\\n  \\\"is_active\\\": false\\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/users",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["users"]
            },
            "description": "Intenta crear un usuario con un email que ya existe (debe fallar)"
          },
          "response": []
        },
        {
          "name": "Crear usuario (Nombre inválido - muy corto)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"name\\\": \\\"AB\\\",\\n  \\\"email\\\": \\\"ab@device-systems.com\\\",\\n  \\\"role\\\": \\\"user\\\",\\n  \\\"is_active\\\": true\\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/users",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["users"]
            },
            "description": "Intenta crear un usuario con nombre muy corto (menor a 3 caracteres)"
          },
          "response": []
        },
        {
          "name": "Crear usuario (Email inválido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"name\\\": \\\"Test Usuario\\\",\\n  \\\"email\\\": \\\"invalid-email\\\",\\n  \\\"role\\\": \\\"user\\\",\\n  \\\"is_active\\\": true\\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/users",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["users"]
            },
            "description": "Intenta crear un usuario con email inválido"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Verificar estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8000/health",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["health"]
            },
            "description": "Verifica que la API esté funcionando correctamente"
          },
          "response": []
        }
      ]
    }
  ]
}
