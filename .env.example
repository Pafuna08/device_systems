"""
Ejemplo de variables de entorno para la aplicación
Copia este archivo a .env y ajusta los valores según tus necesidades
"""

# FastAPI Configuration
APP_NAME=device_systems
API_VERSION=3.0
DEBUG=True

# Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=True

# Database
DATABASE_URL=sqlite:///./device_systems.db

# Security (OAuth2 + JWT) - GA1-220501096-01-AA1-EV11
# Genera tu propio SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
